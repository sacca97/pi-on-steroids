{
  "name": "pi-on-steroids",
  "version": "0.1.0",
  "description": "All-in-one Pi coding agent extension: compact tool rendering and diffs, grouped tool calls, background tasks, /btw side chat, goal mode and searchable compaction history.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "tsx --import ./tests/setup-env.ts --test tests/*.test.ts",
    "check": "npm run lint && npm run test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-tui",
    "coding-agent",
    "tui",
    "tool-rendering",
    "tool-output",
    "diff-visualization",
    "output-truncation",
    "hide",
    "collapse",
    "truncate",
    "compact",
    "diff",
    "output-mode"
  ],
  "author": "sacca97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sacca97/pi-on-steroids.git"
  },
  "bugs": {
    "url": "https://github.com/sacca97/pi-on-steroids/issues"
  },
  "homepage": "https://github.com/sacca97/pi-on-steroids#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0 || ^0.75.0 || ^0.77.0 || ^0.78.0 || ^0.79.0 || ^0.80.0",
    "@earendil-works/pi-tui": "^0.74.0 || ^0.75.0 || ^0.77.0 || ^0.78.0 || ^0.79.0 || ^0.80.0",
    "typebox": "*"
  },
  "overrides": {
    "file-type": ">=21.3.1",
    "protobufjs": "7.6.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "typebox": "1.3.7"
  }
}
